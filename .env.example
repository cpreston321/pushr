# Convex
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Expo push (optional access token for higher rate limits; not required)
EXPO_ACCESS_TOKEN=

# RevenueCat — set on the Convex deployment via `bunx convex env set`.
# REVENUECAT_WEBHOOK_AUTH:  exact value of the Authorization header configured
#   on the RevenueCat dashboard webhook (e.g. "Bearer <secret>").
# REVENUECAT_REST_API_KEY:  REST API v2 secret key with customers:read scope.
#   v1 keys do NOT work — generate a new one at app.revenuecat.com.
# REVENUECAT_PROJECT_ID:    project id from the RevenueCat dashboard URL
#   (proj_…). Required for the v2 reconcile endpoint.
# REVENUECAT_PRO_ENTITLEMENT_ID (optional): internal v2 entitlement id
#   (entla…). When set, reconcile only counts that entitlement; otherwise
#   any active entitlement is treated as pro.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_REST_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_PRO_ENTITLEMENT_ID=
