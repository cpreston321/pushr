EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Optional: EAS project id for push notifications on standalone builds
EXPO_PUBLIC_EAS_PROJECT_ID=

# RevenueCat — public client API keys (safe to bundle). Leave blank to
# keep the dev grant fallback in upgrade.tsx.
# Find these at app.revenuecat.com → Project → API keys (one per platform).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
