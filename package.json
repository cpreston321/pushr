{
  "name": "pushr.sh",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "pushrsh": "./packages/cli/pushrsh.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter @pushr/backend dev",
    "deploy": "bun --filter @pushr/backend deploy",
    "tsc": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "mobile": "bun --filter @pushr/mobile start",
    "web": "bun --filter @pushr/web dev",
    "web:build": "bun --filter @pushr/web build",
    "cli": "bun --filter @pushr/cli start",
    "cli:build": "bun --filter @pushr/cli build",
    "sdk:build": "bun --filter @pushr/sdk build"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "expo-constants": "55.0.16",
    "expo-font": "55.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "signal-exit": "^3.0.7"
  }
}
