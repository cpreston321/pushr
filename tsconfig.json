{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["bun", "node"]
  },
  "include": ["packages/cli/**/*", "packages/sdk/**/*"],
  "exclude": ["node_modules", "**/node_modules", "**/_generated", "**/build", "**/dist"]
}
